{
  "opencollection": "1.0.0",
  "info": {
    "name": "Logik.io Admin API - Blueprint Import/Export Blueprint > Export Managed Tables > Import Tables API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Managed Tables > Import Tables",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Upload Table CSV",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{tenant}.{sector}.logik.io/api/managedTables/v2/managedTables/:tableName",
            "params": [
              {
                "name": "tableName",
                "value": "",
                "type": "path",
                "description": "Name of the Managed Table"
              }
            ],
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "file",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "jobType",
                  "type": "text",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Upload Table CSV"
        },
        {
          "info": {
            "name": "Replace data in table with uploaded data",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{tenant}.{sector}.logik.io/api/managedTables/v2/managedTables/:tableName",
            "params": [
              {
                "name": "tableName",
                "value": "",
                "type": "path",
                "description": "Name of the Managed Table"
              }
            ],
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "file",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "jobType",
                  "type": "text",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Replace data in table with uploaded data"
        }
      ]
    }
  ],
  "bundled": true
}