{
  "opencollection": "1.0.0",
  "info": {
    "name": "Logik.io Admin API - Blueprint Import/Export Blueprint > Export Managed Tables > Export Tables API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Managed Tables > Export Tables",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Export Table Data - Initiate Request",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{tenant}.{sector}.logik.io/api/managedTables/v3/managedTables/:tableName/export",
            "params": [
              {
                "name": "tableName",
                "value": "",
                "type": "path",
                "description": "Name of the Managed Table"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Export Table Data - Initiate Request"
        },
        {
          "info": {
            "name": "Export Table - Get Job Status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{tenant}.{sector}.logik.io/api/managedTables/v2/job/:tableExportJobId",
            "params": [
              {
                "name": "tableExportJobId",
                "value": "16",
                "type": "path",
                "description": "Job Id"
              }
            ]
          },
          "docs": "Export Table - Get Job Status"
        },
        {
          "info": {
            "name": "Export Table - Download File",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{tenant}.{sector}.logik.io/api/managedTables/v2/job/:tableExportJobId/file",
            "params": [
              {
                "name": "tableExportJobId",
                "value": "16",
                "type": "path",
                "description": "Job Id"
              }
            ]
          },
          "docs": "Export Table - Download File"
        }
      ]
    }
  ],
  "bundled": true
}